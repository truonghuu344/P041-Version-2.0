# Copy this file to frontend/.env.local. Do not commit .env.local.
# Next.js proxies /api/v1/* to the Dockerized FastAPI backend during local development.
API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: same OAuth Web Client ID as GOOGLE_OAUTH_CLIENT_ID in the root .env.
# This value is intentionally public and is embedded in the browser bundle.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
