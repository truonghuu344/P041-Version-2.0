# ============================================
# Career Assistant — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Application ----
APP_NAME=Career Assistant Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Generate a private value, for example: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=career-assistant
JWT_AUDIENCE=career-assistant-api
AUTH_COOKIE_NAME=career_access_token

# Exact browser origins only; do not add paths or a trailing slash.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://career_assistant:replace-password@localhost:5432/career_assistant
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_HEALTHCHECK_TIMEOUT=5

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- Google Authentication ----
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ---- LLM Providers ----
# Configure at least one provider. Never commit a real API key.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-your-ai-log-key
AI_LOG_DIR=.ai-log

# ---- Frontend build ----
API_PROXY_TARGET=http://localhost:8000
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
