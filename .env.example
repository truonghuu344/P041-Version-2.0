# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
GEMINI_API_KEY=your-gemini-api-key-here
# OAuth Web Client ID từ Google Cloud Console (không phải client secret)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_API_KEY cũng được hỗ trợ như alias tương thích Google SDK
MODEL_NAME=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

# ---- Database ----
# Docker Compose: set POSTGRES_PASSWORD, then it derives DATABASE_URL automatically.
POSTGRES_USER=career_assistant
POSTGRES_PASSWORD=change-this-to-a-long-random-password
POSTGRES_DB=career_assistant
# DATABASE_URL is only needed when running the API outside Docker.
# DATABASE_URL=postgresql+asyncpg://career_assistant:password@localhost:5432/career_assistant
# For SQLite (development): DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store / Market JD RAG ----
# Docker Compose overrides this URL to http://qdrant:6333.
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=market_job_descriptions
# auto: Gemini when an API key exists; otherwise an offline hashing embedding.
QDRANT_EMBEDDING_PROVIDER=auto
QDRANT_EMBEDDING_MODEL=gemini-embedding-2
QDRANT_VECTOR_SIZE=768
QDRANT_TIMEOUT_SECONDS=10
QDRANT_SYNC_ON_STARTUP=true
QDRANT_AUTO_SYNC=true

# ---- App Config ----
SECRET_KEY=replace-with-a-long-random-secret
JWT_TOKEN_VERSION=2
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_MB=12

# ---- Email OTP for password reset ----
# Gmail: enable 2-Step Verification, then create a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_OTP_RESEND_SECONDS=60

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-your-ai-log-key
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# Backend target cho Next.js proxy (browser sẽ gọi cùng origin qua /api/v1)
API_PROXY_TARGET=http://127.0.0.1:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# local: không tự gửi CV ra ngoài; UI có thể yêu cầu gọi Gemini cho từng lần phân tích
CV_PARSER_MODE=local
# CV-JD matching pipeline v1
MAX_REQUEST_BODY_MB=22
DOCUMENT_MAX_FILE_SIZE_MB=20
DOCUMENT_MAX_PAGES=20
MALWARE_SCAN_MODE=auto
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CV_JD_EMBEDDING_PROVIDER=auto
CV_JD_EMBEDDING_MODEL=gemini-embedding-2
CV_JD_EMBEDDING_DIMENSIONS=768
CV_JD_BM25_TOP_K=20
CV_JD_SEMANTIC_TOP_K=20
CV_JD_SEMANTIC_MIN_SCORE=0.45
CV_JD_RRF_K=60
CV_JD_HYBRID_TOP_K=10
CV_JD_EVIDENCE_MAX_PER_REQUIREMENT=3
CV_JD_SCORE_DECIMAL_PLACES=1
CV_JD_EXTRACTION_MIN_CONFIDENCE=0.50
CV_JD_RATING_POOR_MAX=49.9
CV_JD_RATING_AVERAGE_MAX=69.9
CV_JD_RATING_GOOD_MAX=84.9
