# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Object Storage (Cloudflare R2) ----
# Local: STORAGE_PROVIDER=local. Render production: set STORAGE_PROVIDER=r2
# and fill all S3-compatible R2 credentials in Render Environment Variables.
STORAGE_PROVIDER=r2
# S3_ENDPOINT_URL=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=career-assistant
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
FILE_URL_TTL_SECONDS=300
AUDIO_RETENTION_DAYS=30

# ---- Neon PostgreSQL (production) ----
# On Render, override DATABASE_URL using the Neon pooled SSL connection URL:
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-host>/<db>?sslmode=require
# Run once in Neon SQL Editor: CREATE EXTENSION IF NOT EXISTS vector;

# ---- LLM Configuration ----
# Optional. Leave empty for a no-Gemini deployment; local parsing, matching
# and vector search still run.
# GEMINI_API_KEY=your-gemini-api-key-here
# OAuth Web Client ID từ Google Cloud Console (không phải client secret)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_API_KEY cũng được hỗ trợ như alias tương thích Google SDK
MODEL_NAME=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
CV_PARSER_MODE=local
# Keep false: a full CV is never sent to Gemini for structured parsing.
CV_STRUCTURED_PARSE_LLM_ENABLED=false
# When true, Gemini only receives verified match evidence to improve wording.
# Keep the interactive Match CTA deterministic so it can respond within 5s.
# Optional Gemini wording can be enabled only for the separate Gap Analysis flow.
MATCH_EXPLANATION_LLM_ENABLED=false
# Persist and reuse a completed report for the same immutable CV/JD snapshots.
GAP_ANALYSIS_CACHE_ENABLED=true
# Change this only when the review prompt/response contract changes.
GAP_ANALYSIS_CACHE_VERSION=v1

# ---- Voice Mock Interview (Pipeline 3: Gemini Live STT + Gemini LLM + ElevenLabs TTS) ----
# STT dùng Gemini Live API (miễn phí, không giới hạn RPM/RPD ở free tier)
# nên chỉ cần GEMINI_API_KEY ở trên, không cần key STT riêng.
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
VOICE_LLM_MODEL=gemini-3.5-flash
# Keep final STAR report generation local for immediate, reliable results.
INTERVIEW_REPORT_LLM_ENABLED=false
# Optional fallback nếu Gemini gặp sự cố:
# OPENAI_API_KEY=your-openai-api-key-here

# TTS: ElevenLabs là nhà cung cấp chính. Bỏ trống key -> tự động dùng gTTS
# (miễn phí, giọng máy). ElevenLabs tính tiền theo ký tự: một buổi phỏng vấn
# khoảng 3.000-5.000 ký tự, hãy đặt quota trước khi mở cho người dùng thật.
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_MODEL=eleven_flash_v2_5
# Voice ID mặc định trong code là giọng tiếng Anh. Chọn giọng hợp tiếng Việt
# rồi dán ID vào đây. Gói Free KHÔNG dùng được "library voice" qua API (402
# paid_plan_required); đã xác minh dùng được trên Free: Sarah, Laura, Alice,
# Matilda, Jessica, Lily, George. Bị chặn: Rachel, Charlotte.
# ELEVENLABS_VOICE_ID_FEMALE=
# ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_TIMEOUT_SECONDS=15

# ---- Database ----
# Docker Compose: set POSTGRES_PASSWORD, then it derives DATABASE_URL automatically.
POSTGRES_USER=career_assistant
POSTGRES_PASSWORD=change-this-to-a-long-random-password
POSTGRES_DB=career_assistant

DATABASE_ECHO=false

# ---- Top Jobs recommendation tuning ----
# Tune only through benchmark/evaluation; do not hard-code these in services.
JOB_RECOMMEND_BM25_K=30
JOB_RECOMMEND_VECTOR_K=30
JOB_RECOMMEND_CANDIDATE_K=30
JOB_RECOMMEND_FINAL_K=10
JOB_RECOMMEND_RRF_K=60
JOB_RECOMMEND_BM25_WEIGHT=1.0
JOB_RECOMMEND_VECTOR_WEIGHT=1.0
JOB_RECOMMEND_MUST_HAVE_THRESHOLD=0.50
JOB_RECOMMEND_SCORE_CAP=49.0
# Reuse the same Top Jobs result for an unchanged CV snapshot, filters and JD catalog.
TOP_JOBS_CACHE_ENABLED=true
# Bump only after changing Top Jobs ranking or result rules.
TOP_JOBS_CACHE_VERSION=v1

# ---- App Config ----
SECRET_KEY=replace-with-a-long-random-secret
JWT_TOKEN_VERSION=2
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_MB=12
# Hard cap for the interactive local Match request (must stay below 5s).
MATCH_TIMEOUT_SECONDS=4.5

# ---- Email OTP for password reset ----
# Gmail: enable 2-Step Verification, then create a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_OTP_RESEND_SECONDS=60

# ---- LangSmith (AI Logs — Deliverable #4, opt-in after adding a real API key) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=ai20k-agent

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-your-ai-log-key
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# Backend target cho Next.js proxy (browser sẽ gọi cùng origin qua /api/v1)
API_PROXY_TARGET=http://127.0.0.1:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# local: không tự gửi CV ra ngoài; UI có thể yêu cầu gọi Gemini cho từng lần phân tích
CV_PARSER_MODE=local

OCR_PROVIDER=mineru
MINERU_AGENT_BASE_URL=https://mineru.net/api/v1/agent
# Create this token in MinerU Console. It is a secret: never commit its value.
# With a token, the backend prefers the authenticated Precision API (VLM).
MINERU_API_TOKEN=
MINERU_PRECISION_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm

# MinerU language code: use `vi` for Vietnamese CV/JD, `en` for English.
MINERU_LANGUAGE=auto
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=false
MINERU_MAX_FILE_SIZE_MB=10
MINERU_TIMEOUT_SECONDS=30
MINERU_POLL_INTERVAL_SECONDS=2
MINERU_POLL_TIMEOUT_SECONDS=120

# Top Jobs và CV-JD matching chạy offline, không tiêu quota embedding Gemini.
VECTOR_EMBEDDING_PROVIDER=hashing
CV_JD_EMBEDDING_PROVIDER=hashing
VECTOR_SYNC_ON_STARTUP=false
VECTOR_AUTO_SYNC=false
# CV-JD matching pipeline v1
