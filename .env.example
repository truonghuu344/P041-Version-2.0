# ==============================================================================
# AI20K Project — Career Assistant X
# MẪU BIẾN MÔI TRƯỜNG: LOCAL DEVELOPMENT & DEPLOYMENT GUIDE (.env.example)
# ==============================================================================
# Hướng dẫn sử dụng:
# 1. Copy file này thành .env cho môi trường chạy local: cp .env.example .env
# 2. Điền các giá trị API key thực tế vào .env.
# 3. KHÔNG BAO GIỜ commit file .env lên Git!
# ==============================================================================


# ==============================================================================
# PHẦN 1: CẤU HÌNH CHỈ DÙNG LOCAL (DEVELOPMENT ONLY)
# ==============================================================================
# Dùng khi chạy ứng dụng trên máy cá nhân hoặc qua Docker Compose:

# [Local App Server]
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# [Local Proxy & CORS]
# Next.js dev server proxy request API về backend local
API_PROXY_TARGET=http://127.0.0.1:8000
# Cho phép frontend local gọi trực tiếp API backend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# [Local Database PostgreSQL / Docker Compose]
# Khi chạy local, backend tự động ghép DATABASE_URL từ 3 biến dưới:
POSTGRES_USER=career_assistant
POSTGRES_PASSWORD=change-this-to-a-secure-local-password
POSTGRES_DB=career_assistant
DATABASE_ECHO=false

# Mật khẩu khởi tạo admin mặc định cho local
INITIAL_ADMIN_PASSWORD=change-this-to-a-strong-admin-password


# ==============================================================================
# PHẦN 2: CẤU HÌNH DEPLOY BACKEND (ĐƯA LÊN RENDER ENVIRONMENT VARIABLES)
# ==============================================================================
# Copy các biến và giá trị ở phần này vào mục Environment Variables trên Render Dashboard:

# --- 2.1. Cấu hình môi trường Production trên Render ---
# (Trên Render set: APP_ENV=production)
# (Trên Render set: CORS_ORIGINS=https://<your-vercel-domain>.vercel.app)
# APP_ENV=production
# CORS_ORIGINS=https://career-assistant-p041.vercel.app

# --- 2.2. Database Production (Neon Serverless PostgreSQL) ---
# Điền URL kết nối Neon pooled có SSL (chạy `CREATE EXTENSION vector;` trên Neon SQL Editor trước)
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-host>/<db>?sslmode=require

# --- 2.3. Object Storage (Cloudflare R2 - Lưu trữ CV & Audio Private) ---
STORAGE_PROVIDER=r2
S3_ENDPOINT_URL=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=career-assistant
S3_REGION=auto
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
FILE_URL_TTL_SECONDS=300
AUDIO_RETENTION_DAYS=30

# --- 2.4. Bảo mật & Xác thực (JWT & Google OAuth Backend) ---
SECRET_KEY=replace-with-a-long-random-secret
JWT_TOKEN_VERSION=2
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- 2.5. AI & LLM Models ---
# Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here
MODEL_NAME=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=45
ASSISTANT_LLM_TIMEOUT_SECONDS=12
ASSISTANT_LLM_MAX_RETRIES=0
CV_PARSER_MODE=local
# Keep false: a full CV is never sent to Gemini for structured parsing.
CV_STRUCTURED_PARSE_LLM_ENABLED=false
# When true, Gemini only receives verified match evidence to improve wording.
MATCH_EXPLANATION_LLM_ENABLED=false
# Persist and reuse a completed report for the same immutable CV/JD snapshots.
GAP_ANALYSIS_CACHE_ENABLED=true
# Change this only when the review prompt/response contract changes.
GAP_ANALYSIS_CACHE_VERSION=v1

# Deepgram Nova-3 (STT streaming cho Voice Interview)
DEEPGRAM_API_KEY=your-deepgram-api-key-here
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID_FEMALE=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID_MALE=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TIMEOUT_SECONDS=15

# OpenAI API Key (Voice conversation engine / fallback)
OPENAI_API_KEY=your-openai-api-key-here

# --- 2.6. OCR Service (MinerU Document Parsing) ---
OCR_PROVIDER=mineru
MINERU_AGENT_BASE_URL=https://mineru.net/api/v1/agent
MINERU_PRECISION_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=your-mineru-api-token
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=auto
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=false
MINERU_MAX_FILE_SIZE_MB=10
MINERU_TIMEOUT_SECONDS=30
MINERU_POLL_INTERVAL_SECONDS=2
MINERU_POLL_TIMEOUT_SECONDS=120

# --- 2.7. Email OTP (Khôi phục mật khẩu qua Gmail SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_OTP_RESEND_SECONDS=60

# --- 2.8. Logging & Giám sát AI (LangSmith & Course AI Logs) ---
LOG_LEVEL=INFO
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=ai20k-agent

AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-your-ai-log-key
AI_LOG_DIR=.ai-log


# ==============================================================================
# PHẦN 3: CẤU HÌNH DEPLOY FRONTEND (ĐƯA LÊN VERCEL ENVIRONMENT VARIABLES)
# ==============================================================================
# Copy các biến ở phần này vào mục Environment Variables trên Vercel Project Settings:

# URL của Render backend để Next.js proxy request /api/v1 sang
# (Ví dụ: https://p041-deploy.onrender.com)
# API_PROXY_TARGET=https://<your-render-backend-service>.onrender.com

# URL WebSocket trực tiếp cho tính năng Voice Mock Interview
NEXT_PUBLIC_VOICE_WS_URL=https://<your-render-backend-service>.onrender.com

# Google OAuth Client ID hiển thị trên button đăng nhập của Frontend
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com


# ==============================================================================
# PHẦN 4: THAM SỐ THUẬT TOÁN & TUNING (DÙNG CHUNG CẢ LOCAL VÀ DEPLOY)
# ==============================================================================
# Các giá trị này có sẵn default trong backend src/config.py, có thể override nếu cần:

# [Rate Limiting]
API_RATE_LIMIT_PER_MINUTE=120

# [CV Parser & Matcher Mode]
CV_PARSER_MODE=local
CV_STRUCTURED_PARSE_LLM_ENABLED=false
MATCH_EXPLANATION_LLM_ENABLED=true
GAP_ANALYSIS_CACHE_ENABLED=true
GAP_ANALYSIS_CACHE_VERSION=v1
MATCH_FINALIZATION_TIMEOUT_SECONDS=60

# [Vector Search & Offline Hashing Embeddings]
VECTOR_SEARCH_ENABLED=true
VECTOR_EMBEDDING_PROVIDER=hashing
CV_JD_EMBEDDING_PROVIDER=hashing
VECTOR_SYNC_ON_STARTUP=false
VECTOR_AUTO_SYNC=false
DEPLOYED_DATA_SYNC_ON_STARTUP=true

# [Top Jobs Recommendation Tuning]
JOB_RECOMMEND_BM25_K=60
JOB_RECOMMEND_VECTOR_K=60
JOB_RECOMMEND_CANDIDATE_K=12
JOB_RECOMMEND_FINAL_K=10
JOB_RECOMMEND_RRF_K=60
JOB_RECOMMEND_BM25_WEIGHT=1.0
JOB_RECOMMEND_VECTOR_WEIGHT=1.0
JOB_RECOMMEND_MUST_HAVE_THRESHOLD=0.75
JOB_RECOMMEND_SCORE_CAP=49.0
JOB_RECOMMEND_READY_CANDIDATE_RESERVE=10
TOP_JOBS_CACHE_ENABLED=true
TOP_JOBS_CACHE_VERSION=v1
